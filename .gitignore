# Сырой датасет (десятки ГБ: DWG/фото/видео) — не годится для git, хранится только локально.
# Раньше здесь были только 2 точечных правила (dataset_extracted/, *.zip) — не
# ловили вторую копию data/raw/dataset_extracted_SUSPECT_20260915/ (23 ГБ) и
# любую будущую подобную папку. Исключаем весь data/raw/ целиком.
data/raw/

# Оригиналы нормативных актов (сторонние документы, в т.ч. с водяными знаками КонсультантПлюс) — только локально
docs/tz_source/normative_acts/
data/cache/
data/processed/
# Аудит-лог веб-UI (data/web_audit/) — рантайм-артефакт (JSONL по датам,
# полный лог каждого /generate и /review), не исходные данные, не публикуется.
data/web_audit/
# Бэкапы data/reference/*.yaml перед автоприменением обновлений (например,
# из загруженного прайс-листа) — рантайм-артефакт, не исходные данные.
data/reference/backups/
*.bak
*.dwl
*.dwl2
Thumbs.db
__pycache__/
*.pyc
.venv/

# Плагин/скилл Claude Code (.claude-plugin) — локальная настройка инструмента,
# не относится к самому проекту озеленения, не публикуется.
.claude/

# Случайный отладочный обрывок в корне (не часть проекта).
diff_prep.txt

# Портфолио-видео (/brag skill) — сгенерированный маркетинговый ролик о
